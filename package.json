{
  "name": "baseui-tanstack-form",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/baseui-tanstack-form.cjs.js",
  "module": "./dist/baseui-tanstack-form.es.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/baseui-tanstack-form.es.js",
      "require": "./dist/baseui-tanstack-form.cjs.js"
    }
  },
  "author": "KahWee Teng <tengkahwee@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepare": "husky install",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/builder-vite": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@tanstack/react-form": "^1.33.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "baseui": "^18.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.3",
    "styletron-engine-atomic": "^1.6.2",
    "styletron-react": "^6.1.1",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "react-input-mask": "npm:@mona-health/react-input-mask@^3.0.3"
  },
  "peerDependencies": {
    "@tanstack/react-form": "*",
    "baseui": ">= 15.0.0",
    "react": ">= 18.0.0",
    "react-dom": ">= 18.0.0",
    "zod": "*"
  },
  "keywords": [
    "react",
    "reactjs",
    "tanstack",
    "tanstack-form",
    "forms",
    "baseui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kahwee/baseui-tanstack-form.git"
  },
  "license": "MIT",
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "printWidth": 80
  }
}
